# TODO: Fill these values in local .env

APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/igaming_research
FRONTEND_ORIGIN=http://localhost:3000

# Scheduler
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0

# External APIs
SERPER_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
# Haiku analyzer rate limits (defaults stay under 50 RPM tier cap)
ANTHROPIC_HAIKU_RATE_LIMIT_ENABLED=true
ANTHROPIC_HAIKU_MAX_RPM=45
ANTHROPIC_HAIKU_MIN_REQUEST_INTERVAL_SECONDS=1.3
ANTHROPIC_HAIKU_MAX_RETRIES=5
ANTHROPIC_HAIKU_RETRY_BASE_SECONDS=2.0
OPENAI_API_KEY=your_key_here
